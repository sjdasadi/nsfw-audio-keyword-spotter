checkpoints/
references/
speaker_refs/
*.pt
*.pth
*.pkl
*.ckpt

# Keep only the non-sensitive word list tracked; ignore any large/raw data
# drops AND the sensitive NSFW word list itself (contains explicit content).
data/*
!data/.gitkeep
!data/normal_words.txt
data/nsfw_words.txt

